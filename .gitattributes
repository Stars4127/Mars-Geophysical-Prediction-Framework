# Treat all text files as text and auto-convert line endings
* text=auto
# Explicitly set line endings for common file types
*.sh text eol=lf
*.py text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
backend/datasets/*.csv filter=lfs diff=lfs merge=lfs -text
backend/neural_nets/**/*.pt filter=lfs diff=lfs merge=lfs -text
tile_cache/*.jpg filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text

